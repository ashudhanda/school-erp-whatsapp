# ---- server ----
PORT=3000
NODE_ENV=development
# ---- Meta WhatsApp Cloud API ----
# Get these from https://developers.facebook.com/apps
META_VERIFY_TOKEN=your_webhook_verify_token
META_APP_SECRET=your_meta_app_secret
WHATSAPP_TOKEN=your_whatsapp_api_token
META_API_VERSION=v21.0  # Optional Meta Graph version override. Verify supported versions in Meta.
# ---- optional Telegram alerts (operator errors go here) ----
# Best-effort: alerts silently no-op when either value is unset, so the bot
# runs fine without Telegram; set both to receive operator error alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ---- AI answers (knowledge responses + photo vision) ----
AI_DAILY_BUDGET=200     # per-day spend cap across all AI providers
AI_KEYS_JSON=[]         # JSON array of provider keys; rotated with cooldowns
# ---- database (production) ----
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# ---- panel bootstrap (first superadmin account) ----
PANEL_SUPERADMIN_EMAIL=
PANEL_SUPERADMIN_PASSWORD=choose_a_strong_password
# ---- demo seeding (empty databases only; never touches real data) ----
SKIP_DEMO_SEED=0        # set to 1 to disable demo data on an intentionally-empty database
DEMO_PHONE_NUMBER_ID=
DEMO_PARENT_NUMBERS=    # comma-separated test parent numbers
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=choose_a_strong_password
DEMO_TEACHER_NUMBER=    # demo teacher's WhatsApp number (flow testing)
DEMO_ADMIN_WAID=        # demo school admin's WhatsApp number (bot-side admin extras)
# ---- approved utility templates for OUTSIDE the 24h window (optional) ----
# Leave blank = free-form only, which works when the parent messaged within 24h.
# WA_TEMPLATE_ABSENT=
# WA_TEMPLATE_PRESENT=
# WA_TEMPLATE_LEAVE=
# Configure school-specific approved templates and photo-AI consent in the panel.
# Never commit actual credentials or student data.
